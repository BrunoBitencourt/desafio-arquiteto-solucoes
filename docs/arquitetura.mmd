
flowchart LR
    CLIENTE["Cliente / Sistema externo"]

    subgraph LANC["lancamentos-service"]
        API1["API REST"]
        DB1[("PostgreSQL<br/>lancamentos_db")]
        PUB["Publicador RabbitMQ"]

        API1 -->|"1. Registra lançamento"| DB1
        DB1 -->|"2. Publica após persistência<br/>(sem Outbox)"| PUB
    end

    subgraph MQ["RabbitMQ"]
        FILA["Fila<br/>lancamentos.criados"]
        DLQ["Dead Letter Queue<br/>lancamentos.criados.dlq"]
    end

    subgraph CONS["consolidacao-service"]
        CONSUMER["Consumer"]
        RETRY["Retentativas<br/>até 2"]
        VALID["Validação e idempotência"]
        DB2[("PostgreSQL<br/>consolidacao_db")]
        API2["API REST<br/>Consulta consolidado"]

        CONSUMER --> RETRY
        RETRY --> VALID
        VALID --> DB2
        DB2 --> API2
    end

    CLIENTE --> API1
    PUB --> FILA
    FILA --> CONSUMER
    RETRY -.->|"Falhas não recuperáveis<br/>ou tentativas esgotadas"| DLQ
    CLIENTE --> API2
